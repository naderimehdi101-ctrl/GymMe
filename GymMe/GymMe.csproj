<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>GymMe</AssemblyName>
    <RootNamespace>GymMe</RootNamespace>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationId>com.companyname.gymme</ApplicationId>
    <ApplicationTitle>GymMe</ApplicationTitle>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Program(1).cs" />
    <Content Update="appsettings(1).json" CopyToOutputDirectory="Never" />
    <PackageReference Include="FluentValidation" Version="12.2.0" />
    <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.1" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="10.3.1" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <Compile Remove="Helpers.cs" />
    <Compile Remove="Endpoints/AuthEndpoint.cs" />
    <Compile Remove="Data/GymDbContext.cs" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <Compile Remove="appsettings.developement.json" />
    <Compile Remove="appsettings.Developement.json.cs" />
    <Compile Remove="appsettings.Development.json.cs" />
    <Content Update="appsettings.Development.json" CopyToOutputDirectory="Never" />
    <Compile Remove="D.T.O/Request/RegisterDTO.cs" />
    <Compile Remove="Services/AuthService.cs" />
    <Compile Remove="Endpoints/UserRegisterEndpoint.cs" />
    <Compile Remove="MemberTest.cs" />
    <Compile Remove="ServiceCollectionExtensions.cs" />
    <Compile Remove="EndpointExtensions.cs" />
    <PackageReference Include="FluentResults" Version="4.0.0" />
    <Compile Remove="ValidationFilter.cs" />
  </ItemGroup>
</Project>